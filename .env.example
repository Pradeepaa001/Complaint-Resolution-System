# Copy this file to .env on the EC2 instance and fill in real values
FLASK_SECRET_KEY=change-this-to-a-random-string

# RDS MySQL
RDS_HOST=your-rds-endpoint.xxxxxxxxxx.ap-south-1.rds.amazonaws.com
RDS_USER=admin
RDS_PASSWORD=your-db-password
RDS_DB=complaint_db

# S3
S3_BUCKET=your-bucket-name
AWS_REGION=ap-south-1
